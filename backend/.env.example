DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# Statement-analysis agent: any OpenAI-compatible endpoint, as used by
# llm-gateway/adk-example. Keep the /v1 suffix when the provider uses it.
# The model behind this endpoint must accept images.
LLM_BASE_URL=https://your-gateway.example/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gemini-3.7-flash

# PostgreSQL (async driver required). With the root compose files the backend
# builds this URL itself; set it only to point at another database.
# Local host example (compose.dev.yaml publishes 127.0.0.1:5432):
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/app
# Used by the compose postgres service (defaults are local-dev only).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Firebase project whose ID tokens are accepted (matches frontend/src/firebase.ts).
FIREBASE_PROJECT_ID=meichu-2026
