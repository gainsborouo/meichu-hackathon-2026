{
  "name": "card-reward-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "typecheck": "wxt prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0",
    "wxt": "^0.20.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
