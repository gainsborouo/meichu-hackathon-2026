# Google OAuth client used only for Calendar consent. Firebase sign-in does not
# grant the calendar.events scope, so that consent is separate -- see
# src/services/googleCodeClient.ts.
#
# Same client as the backend's GOOGLE_CLIENT_ID (the secret stays server-side).
# In Google Cloud Console, the client needs http://localhost:8000 under
# "Authorized JavaScript origins"; the popup flow needs no redirect URI.
VITE_GOOGLE_CLIENT_ID=
