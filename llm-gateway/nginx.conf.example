# DNS: point mcllmh.userwei.com to this host's public IPv4 (and IPv6 if used).
# Install this at /etc/nginx/sites-available/llm-gateway, then enable it.
server {
    listen 80;
    listen [::]:80;
    server_name mcllmh.userwei.com;

    location /v1/ {
        proxy_pass http://127.0.0.1:4141;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for streaming LLM responses (SSE).
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 20m;
    }

    # Keep non-API routes, including gateway management routes, private.
    location / {
        return 404;
    }
}
